# Vercel's Supabase integration uses STORAGE_* names; vite.config.js maps
# these two public values to the names consumed by the React app.
STORAGE_VITE_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
STORAGE_VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-clave-publica

# Optional legacy names for local development without STORAGE_* variables:
# VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# VITE_SUPABASE_ANON_KEY=tu-clave-publica-anon
